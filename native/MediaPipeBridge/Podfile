# MediaPipe Tasks per iOS è distribuito tramite CocoaPods (framework statici precompilati).
# Con linkage statico i pod vengono incorporati nel framework dinamico MediaPipeBridge,
# inclusi i flag -force_load necessari a registrare i grafi MediaPipe.
platform :ios, '17.0'
use_frameworks! :linkage => :static

target 'MediaPipeBridge' do
  pod 'MediaPipeTasksVision', '0.10.21'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
