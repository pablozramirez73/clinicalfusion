<Project>
  <!-- Versioni centralizzate (Central Package Management). Allineate a .NET 11 RC2 / MAUI 11 RC2: MAUI deve corrispondere al workload dell'SDK (la CI installa l'ultima anteprima 11.0.x). Npgsql non ha ancora una RC2 e vuole EF Core esattamente RC1: EF Core (e il suo health check) restano su RC1 finché non esce. -->
  <PropertyGroup>
    <MauiVersion>11.0.0-rc.2.26505.5</MauiVersion>
    <DotNetExtensionsVersion>11.0.0-rc.2.26504.105</DotNetExtensionsVersion>
    <AspNetCoreVersion>11.0.0-rc.2.26504.105</AspNetCoreVersion>
    <EfCoreVersion>11.0.0-rc.1.26425.128</EfCoreVersion>
    <NpgsqlEfVersion>11.0.0-rc.1.1</NpgsqlEfVersion>
    <!-- .NET Aspire (AppHost e ServiceDefaults). La versione dell'SDK dell'AppHost (Aspire.AppHost.Sdk, che porta con sé Aspire.Hosting.AppHost) è in global.json e va tenuta uguale. -->
    <AspireVersion>13.6.1</AspireVersion>
    <!-- Resilienza e service discovery dei client HTTP: escono con Aspire (10.x, valide anche su net11.0). -->
    <AspireExtensionsVersion>10.11.0</AspireExtensionsVersion>
  </PropertyGroup>
  <!--
    Ripiego per ambienti con solo l'SDK .NET 10 (-p:CsfNetTfm=net10.0): i pacchetti ASP.NET Core / EF Core 11
    richiedono net11.0. Serve solo a compilare e testare; il prodotto è net11.0.
  -->
  <PropertyGroup Condition="'$(CsfNetTfm)' == 'net10.0'">
    <AspNetCoreVersion>10.0.12</AspNetCoreVersion>
    <EfCoreVersion>10.0.12</EfCoreVersion>
    <NpgsqlEfVersion>10.0.3</NpgsqlEfVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNetExtensionsVersion)" />
    <!-- SQLite cifrato: Microsoft.Data.Sqlite.Core (senza provider) + SQLite3 Multiple Ciphers in modalità SQLCipher v4. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <!-- Android: CameraX. Le dipendenze Java di MediaPipe hanno la versione in ClinicalSensorFusion.MediaPipe.Android. -->
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />
    <!-- Server -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="$(AspNetCoreVersion)" />
    <!-- Telemetria: esportazione OTLP di metriche, tracce e log (attiva solo se configurata). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <!-- .NET Aspire: orchestrazione in sviluppo (src/ClinicalSensorFusion.AppHost) e impostazioni comuni dei servizi. -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <!-- Dipendenza indiretta di Aspire.Hosting: 2.5.302 ha GHSA-qhrr-8q5h-9q3h, corretta in 2.5.303. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(AspireExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(AspireExtensionsVersion)" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Solo nei test: modello FHIR R4 di riferimento (Firely) per verificare che le risorse prodotte siano valide. -->
    <PackageVersion Include="Hl7.Fhir.R4" Version="6.6.0" />
  </ItemGroup>
</Project>
