<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <!-- Marchio: blu notte dell'icona + verde acqua della croce. -->
  <Color x:Key="Primary">#0B3D5C</Color>
  <Color x:Key="PrimaryDeep">#062B42</Color>
  <Color x:Key="Accent">#14B8A6</Color>
  <Color x:Key="AccentBright">#4FD1C5</Color>

  <!-- Semantici -->
  <Color x:Key="Danger">#DC2626</Color>
  <Color x:Key="Warning">#D97706</Color>
  <Color x:Key="Ok">#059669</Color>
  <Color x:Key="Idle">#94A3B8</Color>

  <!-- Superfici -->
  <Color x:Key="SurfaceLight">#F1F5F9</Color>
  <Color x:Key="SurfaceDark">#0B1220</Color>
  <Color x:Key="CardLight">#FFFFFF</Color>
  <Color x:Key="CardDark">#141D2E</Color>
  <Color x:Key="FieldLight">#F4F7FA</Color>
  <Color x:Key="FieldDark">#0E1626</Color>
  <Color x:Key="StrokeLight">#E2E8F0</Color>
  <Color x:Key="StrokeDark">#243146</Color>

  <!-- Testo -->
  <Color x:Key="TextLight">#0F172A</Color>
  <Color x:Key="TextDark">#F1F5F9</Color>
  <Color x:Key="MutedLight">#5B6B80</Color>
  <Color x:Key="MutedDark">#94A3B8</Color>

  <!-- Fondi tenui per chip, avvisi e icone -->
  <Color x:Key="AccentSoftLight">#DDF7F3</Color>
  <Color x:Key="AccentSoftDark">#0F3A3A</Color>
  <Color x:Key="AccentTextLight">#0B6B62</Color>
  <Color x:Key="DangerSoftLight">#FEE2E2</Color>
  <Color x:Key="DangerSoftDark">#3A1518</Color>
  <Color x:Key="DangerTextLight">#991B1B</Color>
  <Color x:Key="DangerTextDark">#FCA5A5</Color>
  <Color x:Key="WarningSoftLight">#FEF3C7</Color>
  <Color x:Key="WarningSoftDark">#3A2A0B</Color>
  <Color x:Key="WarningTextLight">#92400E</Color>
  <Color x:Key="WarningTextDark">#FCD34D</Color>

  <!-- Sovrimpressioni sull'anteprima della fotocamera -->
  <Color x:Key="Scrim">#B30B1220</Color>
</ResourceDictionary>
