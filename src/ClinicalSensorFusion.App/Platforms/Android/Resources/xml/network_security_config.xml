<?xml version="1.0" encoding="utf-8"?>
<!--
  Niente traffico in chiaro: l'app parla solo HTTPS (HttpsOnlyHandler su ogni richiesta). Il server clinico in
  rete locale usa un certificato autofirmato riconosciuto dall'impronta della chiave pubblica (CertificatePin),
  quindi qui bastano i certificati di sistema, non quelli installati dall'utente.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
