<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ClinicalSensorFusion.App.Views"
       x:Class="ClinicalSensorFusion.App.AppShell"
       Shell.FlyoutBehavior="Disabled">
  <TabBar>
    <ShellContent Title="Rilevazioni" Icon="{FontImageSource Glyph='☰', Color={StaticResource Primary}, Size=22}"
                  ContentTemplate="{DataTemplate views:SessionsPage}" Route="sessions" />
    <ShellContent Title="Acquisisci" Icon="{FontImageSource Glyph='◉', Color={StaticResource Primary}, Size=22}"
                  ContentTemplate="{DataTemplate views:CapturePage}" Route="capture" />
    <ShellContent Title="Impostazioni" Icon="{FontImageSource Glyph='⚙', Color={StaticResource Primary}, Size=22}"
                  ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
  </TabBar>
</Shell>
