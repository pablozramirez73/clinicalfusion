<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:l="clr-namespace:ClinicalSensorFusion.App.Localization"
       xmlns:views="clr-namespace:ClinicalSensorFusion.App.Views"
       x:Class="ClinicalSensorFusion.App.AppShell"
       Shell.FlyoutBehavior="Disabled">
  <TabBar>
    <ShellContent Title="{l:Tr Text='Rilevazioni'}" Icon="tab_sessions.png"
                  ContentTemplate="{DataTemplate views:SessionsPage}" Route="sessions" />
    <ShellContent Title="{l:Tr Text='Acquisisci'}" Icon="tab_capture.png"
                  ContentTemplate="{DataTemplate views:CapturePage}" Route="capture" />
    <ShellContent Title="{l:Tr Text='Impostazioni'}" Icon="tab_settings.png"
                  ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
  </TabBar>
</Shell>
