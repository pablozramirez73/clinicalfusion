<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicalSensorFusion.App.ViewModels"
             x:Class="ClinicalSensorFusion.App.Views.SessionsPage"
             x:DataType="vm:SessionsViewModel"
             Title="Rilevazioni">
  <Grid RowDefinitions="Auto,Auto,*" Padding="12,8">
    <SearchBar Placeholder="Cerca per codice soggetto" Text="{Binding SearchText}" />

    <Border Grid.Row="1" Style="{StaticResource Card}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
            BackgroundColor="#FEE2E2" Margin="0,8">
      <Label Text="{Binding ErrorMessage}" TextColor="#991B1B" />
    </Border>

    <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
      <CollectionView ItemsSource="{Binding Sessions}" SelectionMode="None">
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Nessuna rilevazione" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
            <Label Text="Avviare una nuova acquisizione dalla scheda «Acquisisci»." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:SessionListItem">
            <SwipeView>
              <SwipeView.RightItems>
                <SwipeItems>
                  <SwipeItem Text="Elimina" BackgroundColor="{StaticResource Danger}"
                             Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, x:DataType=vm:SessionsViewModel}"
                             CommandParameter="{Binding .}" />
                </SwipeItems>
              </SwipeView.RightItems>
              <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, x:DataType=vm:SessionsViewModel}"
                                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" SemanticProperties.Description="{Binding Subject}">
                  <Label Text="{Binding Subject}" FontAttributes="Bold" FontSize="17" />
                  <Label Grid.Column="1" Text="{Binding When}" Style="{StaticResource Muted}" />
                  <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Details}" Style="{StaticResource Muted}" />
                </Grid>
              </Border>
            </SwipeView>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </RefreshView>
  </Grid>
</ContentPage>
