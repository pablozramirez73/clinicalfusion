<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicalSensorFusion.App.ViewModels"
             xmlns:svc="clr-namespace:ClinicalSensorFusion.App.Services"
             xmlns:controls="clr-namespace:ClinicalSensorFusion.App.Controls"
             x:Class="ClinicalSensorFusion.App.Views.CapturePage"
             x:DataType="vm:CaptureViewModel"
             Title="Acquisizione"
             Shell.NavBarIsVisible="False">
  <Grid RowDefinitions="5*,4*">
    <!-- Anteprima: camera + profondità (Metal) con overlay dei punti MediaPipe -->
    <Grid BackgroundColor="Black">
      <controls:CapturePreview DepthOverlayOpacity="{Binding DepthOpacity}" />
      <GraphicsView x:Name="OverlayView" Drawable="{Binding Overlay}" InputTransparent="True" />

      <Border VerticalOptions="Start" Margin="12,48,12,0" Padding="10,6" BackgroundColor="#99000000" StrokeThickness="0"
              StrokeShape="RoundRectangle 8" IsVisible="{Binding Caption, Converter={StaticResource IsNotNullOrEmpty}}">
        <Label Text="{Binding Caption}" TextColor="White" FontSize="13" />
      </Border>

      <Border VerticalOptions="End" Margin="12" Padding="10,6" BackgroundColor="#CCB45309" StrokeThickness="0"
              StrokeShape="RoundRectangle 8" IsVisible="{Binding Warning, Converter={StaticResource IsNotNullOrEmpty}}">
        <Label Text="{Binding Warning}" TextColor="White" FontSize="13" />
      </Border>

      <Border HorizontalOptions="End" VerticalOptions="Start" Margin="12,92,12,0" Padding="10,4" StrokeThickness="0"
              StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Danger}" IsVisible="{Binding IsRecording}">
        <Label Text="● REC" TextColor="White" FontAttributes="Bold" />
      </Border>

      <Button Text="Profondità" HorizontalOptions="Start" VerticalOptions="Start" Margin="12,92,0,0"
              Style="{StaticResource SecondaryButton}" TextColor="White" BorderColor="White" Padding="10,4" MinimumHeightRequest="32"
              Command="{Binding ToggleDepthCommand}" IsVisible="{Binding LidarAvailable}"
              SemanticProperties.Hint="Mostra o nasconde la mappa di profondità LiDAR" />
    </Grid>

    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="12" Spacing="8">
        <Picker Title="Modalità" ItemsSource="{Binding Modes}" ItemDisplayBinding="{Binding Title, x:DataType=vm:CaptureModeOption}"
                SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding IsRecording, Converter={StaticResource InvertedBool}}" />
        <Label Text="{Binding SelectedMode.Description}" Style="{StaticResource Muted}" />

        <Entry Placeholder="Codice soggetto (pseudonimo, non nome e cognome)" Text="{Binding SubjectCode}"
               IsEnabled="{Binding IsRecording, Converter={StaticResource InvertedBool}}" ReturnType="Next" />
        <Editor Placeholder="Note (facoltative)" Text="{Binding Notes}" AutoSize="TextChanges" MaximumHeightRequest="100" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Text="Avvia rilevazione" Command="{Binding StartCommand}" />
          <Button Grid.Column="1" Text="Termina" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" />
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Text="Valori in tempo reale" Style="{StaticResource Section}" />
        <FlexLayout BindableLayout.ItemsSource="{Binding Tiles}" Wrap="Wrap" JustifyContent="Start">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:MetricTile">
              <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="10,6" WidthRequest="112">
                <VerticalStackLayout>
                  <Label Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="12" />
                  <Label Text="{Binding Value}" FontSize="17" FontAttributes="Bold" />
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Label Text="Sensori" Style="{StaticResource Section}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sensors}" Spacing="2">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="svc:SensorStatus">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="●" TextColor="{Binding Running, Converter={StaticResource StatusColor}}" />
                <Label Grid.Column="1" Text="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
