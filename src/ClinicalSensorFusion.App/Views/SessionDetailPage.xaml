<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:ClinicalSensorFusion.App.Localization"
             xmlns:vm="clr-namespace:ClinicalSensorFusion.App.ViewModels"
             xmlns:controls="clr-namespace:ClinicalSensorFusion.App.Controls"
             xmlns:domain="clr-namespace:ClinicalSensorFusion.Core.Domain;assembly=ClinicalSensorFusion.Core"
             x:Class="ClinicalSensorFusion.App.Views.SessionDetailPage"
             x:DataType="vm:SessionDetailViewModel"
             Title="{l:Tr Text='Rilevazione'}">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="{l:Tr Text='Condividi'}" Command="{Binding ShareSummaryCommand}" />
  </ContentPage.ToolbarItems>

  <ScrollView>
    <VerticalStackLayout Padding="20,8,20,32" Spacing="10">
      <!-- Intestazione -->
      <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0" />
            <GradientStop Color="#0E6B7A" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <VerticalStackLayout Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <controls:ModeBadge Mode="{Binding Mode}" Size="52" OnDark="True" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
              <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation"
                     SemanticProperties.HeadingLevel="Level1" />
              <Label Text="{Binding WhenText}" FontSize="13" TextColor="#CFE3EC" />
            </VerticalStackLayout>
          </Grid>
          <Label Text="{Binding ModeText}" FontSize="13" TextColor="#CFE3EC" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#1FFFFFFF" Padding="12,8">
              <VerticalStackLayout Spacing="1">
                <Label Text="{l:Tr Text='Durata'}" FontSize="11" TextColor="#CFE3EC" />
                <Label Text="{Binding DurationText}" FontSize="17" FontAttributes="Bold" TextColor="White" />
              </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#1FFFFFFF" Padding="12,8">
              <VerticalStackLayout Spacing="1">
                <Label Text="{l:Tr Text='Operatore'}" FontSize="11" TextColor="#CFE3EC" />
                <Label Text="{Binding OperatorName}" FontSize="17" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation" />
              </VerticalStackLayout>
            </Border>
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Invio al server clinico: è la prima cosa che l'operatore vede a fine acquisizione -->
      <Border Style="{StaticResource Card}" IsVisible="{Binding IsSyncAvailable}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Style="{StaticResource IconTile}" VerticalOptions="Start">
              <Path Style="{StaticResource IconUpload}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="{l:Tr Text='Server clinico'}" Style="{StaticResource Headline}" />
              <Label Text="{Binding SyncText}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalOptions="Start" IsVisible="{Binding IsSyncSent}">
              <Label Text="{l:Tr Text='✓ Inviata'}" Style="{StaticResource ChipText}" />
            </Border>
          </Grid>

          <Border Style="{StaticResource BannerDanger}" IsVisible="{Binding SyncError, Converter={StaticResource IsNotNullOrEmpty}}">
            <Label Text="{Binding SyncError}" Style="{StaticResource BannerDangerText}" />
          </Border>

          <Button Text="{l:Tr Text='Invia al server'}" Command="{Binding SendToServerCommand}" IsVisible="{Binding IsSyncPending}" />

          <Border Style="{StaticResource BannerInfo}" IsVisible="{Binding IsSyncSending}">
            <HorizontalStackLayout Spacing="10">
              <ActivityIndicator IsRunning="{Binding IsSyncSending}" WidthRequest="18" HeightRequest="18" />
              <Label Text="{l:Tr Text='Invio in corso: puoi continuare a consultare la rilevazione.'}" Style="{StaticResource BannerInfoText}" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsSyncSent}">
            <Button Text="{l:Tr Text='Apri i grafici'}" Command="{Binding OpenDashboardCommand}" />
            <Button Grid.Column="1" Text="{l:Tr Text='Invia di nuovo'}" Style="{StaticResource SecondaryButton}" HeightRequest="52" CornerRadius="16"
                    Command="{Binding SendToServerCommand}" />
          </Grid>

          <Button Text="{l:Tr Text='Apri le Impostazioni'}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding IsSyncNotConfigured}" />
        </VerticalStackLayout>
      </Border>

      <!-- Esito del test standardizzato -->
      <Border Style="{StaticResource Card}" IsVisible="{Binding HasTest}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Style="{StaticResource IconTile}" VerticalOptions="Start">
              <Path Style="{StaticResource IconPulse}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0">
              <Label Text="{Binding TestName}" Style="{StaticResource Muted}" />
              <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding TestValue}" FontSize="28" FontAttributes="Bold" />
                <Border Style="{StaticResource Chip}" VerticalOptions="Center" IsVisible="{Binding TestEstimated}">
                  <Label Text="{l:Tr Text='stima'}" Style="{StaticResource ChipText}" />
                </Border>
              </HorizontalStackLayout>
            </VerticalStackLayout>
          </Grid>
          <Border Style="{StaticResource BannerInfo}" IsVisible="{Binding TestIsOk}">
            <Label Text="{Binding TestInterpretation}" Style="{StaticResource BannerInfoText}" />
          </Border>
          <Border Style="{StaticResource BannerInfo}" IsVisible="{Binding TestFlag}"
                  BackgroundColor="{AppThemeBinding Light={StaticResource WarningSoftLight}, Dark={StaticResource WarningSoftDark}}">
            <Label Text="{Binding TestInterpretation}" Style="{StaticResource ChipWarningText}" FontSize="13" FontAttributes="None" />
          </Border>
          <Label Text="{Binding TestReference}" Style="{StaticResource Muted}" FontSize="12" />
          <Label Text="{Binding TestSource}" Style="{StaticResource Muted}" FontSize="11" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}" IsVisible="{Binding Notes, Converter={StaticResource IsNotNullOrEmpty}}">
        <VerticalStackLayout Spacing="4">
          <Label Text="{l:Tr Text='Note'}" Style="{StaticResource FieldLabel}" Margin="0" />
          <Label Text="{Binding Notes}" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource BannerDanger}" BackgroundColor="{AppThemeBinding Light={StaticResource WarningSoftLight}, Dark={StaticResource WarningSoftDark}}"
              IsVisible="{Binding HasSummary, Converter={StaticResource InvertedBool}}">
        <Label Text="{l:Tr Text='Rilevazione interrotta: gli indicatori non sono stati calcolati.'}" Style="{StaticResource ChipWarningText}" FontSize="13" FontAttributes="None" />
      </Border>

      <!-- Indicatori -->
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Summary}" Spacing="4">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:SummaryGroup">
            <VerticalStackLayout Spacing="6">
              <Label Text="{Binding Section}" Style="{StaticResource Section}" />
              <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="12">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:SummaryRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Value}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"
                               IsVisible="{Binding Warning, Converter={StaticResource InvertedBool}}" />
                        <Border Grid.Column="1" Style="{StaticResource ChipWarning}" HorizontalOptions="End" VerticalOptions="Center"
                                IsVisible="{Binding Warning}">
                          <Label Text="{Binding Value}" Style="{StaticResource ChipWarningText}" FontSize="14" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </Border>
            </VerticalStackLayout>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>

      <!-- Sensori ambientali: una scheda per sensore, riquadri per canale; l'interruttore li nasconde. -->
      <VerticalStackLayout Spacing="6" IsVisible="{Binding HasEnvironment}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <Label Text="{l:Tr Text='Sensori ambientali'}" Style="{StaticResource Section}" VerticalOptions="Center" />
          <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" Margin="0,14,0,2">
            <Label Text="{l:Tr Text='Mostra'}" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <Switch IsToggled="{Binding ShowEnvironment}" VerticalOptions="Center"
                    SemanticProperties.Description="{l:Tr Text='Mostra o nascondi i sensori ambientali'}" />
          </HorizontalStackLayout>
        </Grid>

        <Label Text="{l:Tr Text='Nascosti: attiva «Mostra» per vedere barometro, luce, posizione e stato del dispositivo.'}"
               Style="{StaticResource Muted}" Margin="4,0"
               IsVisible="{Binding ShowEnvironment, Converter={StaticResource InvertedBool}}" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Environment}" Spacing="10" IsVisible="{Binding ShowEnvironment}">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="domain:SensorCard">
              <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="10">
                  <HorizontalStackLayout Spacing="10">
                    <Border Style="{StaticResource IconTile}" WidthRequest="30" HeightRequest="30">
                      <Path Style="{StaticResource IconWave}" Scale="0.8" />
                    </Border>
                    <Label Text="{Binding Sensor}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                  </HorizontalStackLayout>
                  <FlexLayout BindableLayout.ItemsSource="{Binding Tiles}" Wrap="Wrap" JustifyContent="Start" Margin="-4,0">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="domain:SensorTile">
                        <Border FlexLayout.Basis="50%" Margin="4" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}">
                          <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Warning}" Value="True">
                              <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningSoftLight}, Dark={StaticResource WarningSoftDark}}" />
                            </DataTrigger>
                          </Border.Triggers>
                          <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" Style="{StaticResource MetricName}" />
                            <Label Text="{Binding Value}" Style="{StaticResource MetricValue}" FontSize="17" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasDetail}" />
                          </VerticalStackLayout>
                        </Border>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>

      <!-- Audio -->
      <Label Text="{l:Tr Text='Registrazioni audio'}" Style="{StaticResource Section}" />
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Audio}" Spacing="8">
        <BindableLayout.EmptyView>
          <Label Text="{l:Tr Text='Nessuna registrazione.'}" Style="{StaticResource Muted}" Margin="4,0" />
        </BindableLayout.EmptyView>
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:AudioItem">
            <Border Style="{StaticResource Card}" Padding="14">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                  <Path Style="{StaticResource IconWave}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                  <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                  <Label Text="{Binding Details}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="▶" Style="{StaticResource SecondaryButton}" WidthRequest="46" Padding="0" CornerRadius="23"
                        VerticalOptions="Center"
                        Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type vm:SessionDetailViewModel}}, x:DataType=vm:SessionDetailViewModel}"
                        CommandParameter="{Binding .}" SemanticProperties.Description="{l:Tr Text='Riproduci o ferma'}" />
              </Grid>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>

      <!-- Modello linguistico -->
      <Label Text="{l:Tr Text='Analisi con IA (Ollama)'}" Style="{StaticResource Section}" />
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Style="{StaticResource IconTile}" VerticalOptions="Start">
              <Path Style="{StaticResource IconSparkle}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="{l:Tr Text='Chiedi al modello'}" Style="{StaticResource Headline}" />
              <Label Style="{StaticResource Muted}"
                     Text="{l:Tr Text='Riceve solo gli indicatori numerici, senza codice soggetto né nome operatore. Il testo generato è di supporto e non sostituisce la valutazione clinica.'}" />
            </VerticalStackLayout>
          </Grid>
          <controls:FormField>
            <Entry Placeholder="{l:Tr Text='Domanda specifica (facoltativa)'}" Text="{Binding Question}" ReturnType="Done" />
          </controls:FormField>
          <!-- Un solo pulsante: durante la generazione diventa «Interrompi» -->
          <Grid>
            <Button Text="{l:Tr Text='Analizza'}" Command="{Binding AnalyzeCommand}"
                    IsVisible="{Binding IsAnalyzing, Converter={StaticResource InvertedBool}}" />
            <Button Text="{l:Tr Text='Interrompi'}" Style="{StaticResource SecondaryButton}" HeightRequest="52" CornerRadius="16"
                    Command="{Binding CancelAnalysisCommand}" IsVisible="{Binding IsAnalyzing}" />
          </Grid>
          <Border Style="{StaticResource BannerInfo}" IsVisible="{Binding IsAnalyzing}">
            <HorizontalStackLayout Spacing="10">
              <ActivityIndicator IsRunning="{Binding IsAnalyzing}" WidthRequest="18" HeightRequest="18" />
              <Label Text="{l:Tr Text='Il modello sta scrivendo…'}" Style="{StaticResource BannerInfoText}" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>
          <Label Text="{Binding AnalysisText}" LineHeight="1.15" IsVisible="{Binding AnalysisText, Converter={StaticResource IsNotNullOrEmpty}}" />
        </VerticalStackLayout>
      </Border>

      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analyses}" Spacing="8">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:AnalysisItem">
            <Border Style="{StaticResource Card}">
              <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Border Style="{StaticResource Chip}" VerticalOptions="Center">
                    <Label Text="{Binding Model}" Style="{StaticResource ChipText}" LineBreakMode="TailTruncation" />
                  </Border>
                  <Label Grid.Column="1" Text="{Binding When}" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding Response}" LineHeight="1.15" />
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
