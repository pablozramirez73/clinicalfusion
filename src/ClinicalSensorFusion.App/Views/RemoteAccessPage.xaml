<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:ClinicalSensorFusion.App.Localization"
             xmlns:vm="clr-namespace:ClinicalSensorFusion.App.ViewModels"
             x:Class="ClinicalSensorFusion.App.Views.RemoteAccessPage"
             x:DataType="vm:RemoteAccessViewModel"
             Title="{l:Tr Text='Accesso remoto'}">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="{l:Tr Text='Esci'}" Command="{Binding LogoutCommand}" />
    <ToolbarItem Text="{l:Tr Text='Fatto'}" Command="{Binding DoneCommand}" />
  </ContentPage.ToolbarItems>
  <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="0,8,0,0">
    <Border Style="{StaticResource BannerInfo}" Margin="20,0">
      <Label Text="{l:Tr Text='Completa il login; quando compare l\'elenco dei modelli tocca «Fatto».'}" Style="{StaticResource BannerInfoText}" />
    </Border>
    <WebView Grid.Row="1" Source="{Binding Url}" />
  </Grid>
</ContentPage>
