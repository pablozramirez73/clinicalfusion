<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Binding .NET della facciata Java su MediaPipe Tasks Vision (Pose / Hands / Face Landmarker) per Android.
    Speculare a ClinicalSensorFusion.MediaPipe (bridge Swift per iOS): si lega a .NET solo la facciata
    in Java/, mentre la libreria di Google è inclusa così com'è (Bind="false").
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <RootNamespace>ClinicalSensorFusion.MediaPipe</RootNamespace>
    <!--
      Più recente del pod iOS (0.10.21): su Android servono le librerie native allineate a 16 KB,
      richieste dai telefoni con Android 15+ e assenti nelle versioni precedenti.
    -->
    <MediaPipeVersion>0.10.35</MediaPipeVersion>
    <!--
      Versioni dei pacchetti qui e non in Directory.Packages.props: la verifica delle dipendenze Java
      (che abbina i POM di Maven ai pacchetti NuGet) legge la versione dal PackageReference.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <AndroidJavaSource Update="Java/**/*.java" Bind="true" />
    <TransformFile Include="Transforms/Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <AndroidMavenLibrary Include="com.google.mediapipe:tasks-vision" Version="$(MediaPipeVersion)" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.mediapipe:tasks-core" Version="$(MediaPipeVersion)" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.flogger:flogger" Version="0.6" Bind="false" />
    <AndroidMavenLibrary Include="com.google.flogger:flogger-system-backend" Version="0.6" Bind="false" />
    <AndroidMavenLibrary Include="com.google.protobuf:protobuf-javalite" Version="4.26.1" Bind="false" />
    <!-- Annotazioni di sola compilazione: non servono a eseguire MediaPipe. -->
    <AndroidIgnoredJavaDependency Include="org.checkerframework:checker-compat-qual:2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
    <PackageReference Include="Xamarin.Google.Guava" Version="33.7.1" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportApi" Version="4.1.1.1" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" Version="4.1.1.2" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportRuntime" Version="4.1.1.1" />
  </ItemGroup>
</Project>
